# general things to ignore
build/
dist/
*.egg-info/
*.egg
*.py[cod]
__pycache__/
*.so
*~
venv/

# due to using nox and pytest
.nox
.cache

# --- IntelliJ IDEA (JetBrains) ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- Python ---
*$py.class

# --- Virtual Environments (非常重要，不要上传你的venv) ---
env/
.env

# --- Local Data (数据太大，不要上传到GitHub，除非是小的样例) ---
# 我们通常保留 data/ 文件夹结构，但忽略里面的大文件
data/*.parquet
data/*.csv
data/*.log

# --- Streamlit ---
.streamlit/secrets.toml

# --- Mac OS (如果你用Mac) ---
.DS_Store
